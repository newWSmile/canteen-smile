{
  "name": "canteen-smile-web-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "20.19.0",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev:platform": "pnpm --filter @canteen-smile/platform-admin dev",
    "dev:tenant-admin": "pnpm --filter @canteen-smile/tenant-admin dev",
    "dev:tenant-portal": "pnpm --filter @canteen-smile/tenant-portal dev",
    "dev:all": "pnpm --parallel --filter ./apps/** dev",
    "typecheck": "pnpm --recursive --filter ./apps/** typecheck",
    "build": "pnpm --recursive --filter ./apps/** build"
  }
}
