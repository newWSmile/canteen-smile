<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.canteen.smile.modules.auth.mapper.CredentialMapper">

    <resultMap id="credentialResultMap" type="com.canteen.smile.modules.auth.entity.CredentialEntity">
        <id property="id" column="id"/>
        <result property="subjectType" column="subject_type"/>
        <result property="subjectId" column="subject_id"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="algorithm" column="algorithm"/>
        <result property="passwordChangedAt" column="password_changed_at"/>
        <result property="credentialVersion" column="credential_version"/>
        <result property="status" column="status"/>
        <result property="version" column="version"/>
    </resultMap>

    <select id="countPlatformCredentials" resultType="long">
        SELECT COUNT(1)
        FROM public.auth_credential
        WHERE subject_type = 'PLATFORM_IDENTITY'
          AND is_deleted = false
    </select>

    <select id="selectBySubject" resultMap="credentialResultMap">
        SELECT
            id,
            subject_type,
            subject_id,
            password_hash,
            algorithm,
            password_changed_at,
            credential_version,
            status,
            version
        FROM public.auth_credential
        WHERE subject_type = #{subjectType}
          AND subject_id = #{subjectId}
          AND is_deleted = false
        LIMIT 1
    </select>

    <insert id="insertCredential"
            parameterType="com.canteen.smile.modules.auth.entity.CredentialEntity"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        INSERT INTO public.auth_credential (
            subject_type,
            subject_id,
            password_hash,
            algorithm,
            password_changed_at,
            credential_version,
            status,
            created_by,
            updated_by
        ) VALUES (
            #{subjectType},
            #{subjectId},
            #{passwordHash},
            #{algorithm},
            #{passwordChangedAt},
            #{credentialVersion},
            #{status},
            #{subjectId},
            #{subjectId}
        )
    </insert>
</mapper>
