<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.canteen.smile.modules.tenant.mapper.TenantMapper">

    <resultMap id="tenantEntityResultMap" type="com.canteen.smile.modules.tenant.entity.TenantEntity">
        <id property="id" column="id"/>
        <result property="tenantCode" column="tenant_code"/>
        <result property="name" column="name"/>
        <result property="status" column="status"/>
        <result property="rootOrganizationId" column="root_organization_id"/>
        <result property="securityVersion" column="security_version"/>
        <result property="templateVersion" column="template_version"/>
        <result property="provisionStatus" column="provision_status"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdTime" column="created_time"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="updatedTime" column="updated_time"/>
        <result property="deleted" column="is_deleted"/>
        <result property="version" column="version"/>
    </resultMap>

    <sql id="tenantColumns">
        id,
        tenant_code,
        name,
        status,
        root_organization_id,
        security_version,
        template_version,
        provision_status,
        created_by,
        created_time,
        updated_by,
        updated_time,
        is_deleted,
        version
    </sql>

    <select id="selectById" resultMap="tenantEntityResultMap">
        SELECT <include refid="tenantColumns"/>
        FROM public.iam_tenant
        WHERE id = #{tenantId} AND is_deleted = false
        LIMIT 1
    </select>

    <select id="countActiveTenants" resultType="long">
        SELECT COUNT(1)
        FROM public.iam_tenant
        WHERE is_deleted = false
        <if test="status != null">
            AND status = #{status}
        </if>
    </select>

    <select id="selectActiveTenantPage" resultMap="tenantEntityResultMap">
        SELECT
        <include refid="tenantColumns"/>
        FROM public.iam_tenant
        WHERE is_deleted = false
        <if test="status != null">
            AND status = #{status}
        </if>
        ORDER BY id DESC
        LIMIT #{limit}
        OFFSET #{offset}
    </select>
</mapper>
