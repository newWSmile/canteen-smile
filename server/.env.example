SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=5432
DB_NAME=canteen_smile
DB_USERNAME=postgres
DB_PASSWORD=change-me-locally

# IAM 使用独立 PostgreSQL 数据库；数据库名和账号由部署环境确认。
IAM_DB_URL=jdbc:postgresql://localhost:5432/TODO_REPLACE_IAM_DB_NAME
IAM_DB_USERNAME=postgres
IAM_DB_PASSWORD=change-me-locally

REDIS_CLUSTER_NODES=TODO_REPLACE_REDIS_NODE_1:6379,TODO_REPLACE_REDIS_NODE_2:6379,TODO_REPLACE_REDIS_NODE_3:6379
REDIS_CLUSTER_MAX_REDIRECTS=3
REDIS_CLUSTER_REFRESH_PERIOD=30s
REDIS_USERNAME=
REDIS_PASSWORD=

GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
AUTH_SERVICE_URI=http://127.0.0.1:8081
IAM_SERVICE_PORT=8082
IAM_SERVICE_URI=http://127.0.0.1:8082

# RSA 密钥对默认复用 30 天；每次登录的 nonce 挑战仍为短期且仅能消费一次。
PASSWORD_ENVELOPE_RSA_KEY_ROTATION_DAYS=30

# 首位平台管理员引导密钥：本地生成至少 32 字节高熵值；引导完成后从运行环境移除。
PLATFORM_BOOTSTRAP_SECRET=

# Auth 与 IAM 双向内部调用的 HMAC 共享密钥：两个服务必须读取同一安全值，禁止提交真实值。
INTERNAL_HMAC_AUTH_TO_IAM_SECRET=
INTERNAL_HMAC_CALLER_ID=smile-auth-service
INTERNAL_HMAC_IAM_CALLER_ID=smile-iam-service
INTERNAL_HMAC_KEY_ID=v1
